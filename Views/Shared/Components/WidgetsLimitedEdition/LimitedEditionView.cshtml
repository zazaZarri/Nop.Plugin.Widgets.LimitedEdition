@using System.Linq
@using System.Globalization
@model Nop.Plugin.Widgets.LimitedEdition.Models.HomepageOffersModel

@{
    var s = Model.Style ?? new Nop.Plugin.Widgets.LimitedEdition.Models.StyleSettingsModel();
    var layoutClass = s.TimerLayout switch
    {
        Nop.Plugin.Widgets.LimitedEdition.Domain.TimerLayoutType.Boxed => "le-layout-boxed",
        Nop.Plugin.Widgets.LimitedEdition.Domain.TimerLayoutType.Minimal => "le-layout-minimal",
        _ => "le-layout-horizontal"
    };
    var templateId = Model.CardTemplateId;
    var templateClass = templateId switch
    {
        1 => "le-tpl-minimal",
        2 => "le-tpl-neon",
        3 => "le-tpl-soft",
        4 => "le-tpl-story",
        _ => "le-tpl-classic"
    };
    if (Model.CompactLayout)
    {
        templateClass += " le-compact";
    }
    var offers = Model.Offers ?? Enumerable.Empty<Nop.Plugin.Widgets.LimitedEdition.Models.PublicInfoModel>();
}

<style>
    .le-wrap {
        --le-accent: @s.AccentColor;
        --le-accent-light: @s.AccentColorLight;
        --le-bg-start: @s.CardBackgroundStart;
        --le-bg-mid: @s.CardBackgroundMid;
        --le-bg-end: @s.CardBackgroundEnd;
        --le-border: @s.BorderColor;
        --le-title: @s.TitleColor;
        --le-message: @s.MessageColor;
        --le-badge-text: @s.BadgeTextColor;
        --le-badge-bg-start: @s.BadgeBackgroundStart;
        --le-badge-bg-end: @s.BadgeBackgroundEnd;
        --le-digit: @s.TimerDigitColor;
        --le-label: @s.TimerLabelColor;
        --le-box-bg: @s.TimerBoxBackground;
        --le-box-border: @s.TimerBoxBorderColor;
        --le-cta-bg-start: @s.CtaBackgroundStart;
        --le-cta-bg-end: @s.CtaBackgroundEnd;
        --le-cta-text: @s.CtaTextColor;
        --le-digit-size: @(s.TimerDigitFontSize)px;
        --le-label-size: @(s.TimerLabelFontSize)px;
        --le-box-min-w: @(s.TimerBoxMinWidth > 0 ? s.TimerBoxMinWidth : 58)px;
        --le-box-radius: @(s.TimerBoxBorderRadius)px;
        --le-box-pad: @(s.TimerBoxPadding)px;
        --le-timer-gap: @(s.TimerGap)px;
        --le-card-radius: @(s.CardBorderRadius)px;
        --le-card-pad-t: @(s.CardPaddingTop)px;
        --le-card-pad-s: @(s.CardPaddingSide)px;
        --le-card-pad-b: @(s.CardPaddingBottom)px;
        --le-card-margin-b: @(s.CardMarginBottom)px;
        --le-card-border-w: @(s.CardBorderWidth)px;
        --le-card-align: @s.CardTextAlign;
        --le-title-size: @(s.TitleFontSize)px;
        --le-title-weight: @s.TitleFontWeight;
        --le-msg-size: @(s.MessageFontSize)px;
        --le-badge-size: @(s.BadgeFontSize)px;
        --le-badge-weight: @s.BadgeFontWeight;
        --le-badge-ls: @(s.BadgeLetterSpacing)px;
        --le-badge-py: @(s.BadgePaddingY)px;
        --le-badge-px: @(s.BadgePaddingX)px;
        --le-cta-size: @(s.CtaFontSize)px;
        --le-cta-weight: @s.CtaFontWeight;
        --le-cta-py: @(s.CtaPaddingY)px;
        --le-cta-px: @(s.CtaPaddingX)px;
        --le-cta-radius: @(s.CtaBorderRadius)px;
        --le-font: @s.FontFamily;
        font-family: var(--le-font);
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }
    .le-card {
        position: relative;
        background: linear-gradient(145deg, var(--le-bg-start) 0%, var(--le-bg-mid) 55%, var(--le-bg-end) 100%);
        border: var(--le-card-border-w) solid var(--le-border);
        border-radius: var(--le-card-radius);
        padding: var(--le-card-pad-t) var(--le-card-pad-s) var(--le-card-pad-b);
        margin-bottom: var(--le-card-margin-b);
        text-align: var(--le-card-align);
        overflow: hidden;
        box-shadow: 0 12px 40px rgba(0,0,0,.35);
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }
    .le-card.le-has-img {
        background-size: cover;
        background-position: center;
        min-height: 260px;
    }
    .le-card.le-has-img::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(0,0,0,.35) 0%, rgba(0,0,0,.78) 100%);
        pointer-events: none;
        z-index: 0;
    }
    .le-card.le-has-img > * { position: relative; z-index: 1; }

    .le-badge {
        display: inline-block;
        font-size: var(--le-badge-size);
        font-weight: var(--le-badge-weight);
        letter-spacing: var(--le-badge-ls);
        text-transform: uppercase;
        color: var(--le-badge-text);
        background: linear-gradient(90deg, var(--le-badge-bg-start), var(--le-badge-bg-end));
        padding: var(--le-badge-py) var(--le-badge-px);
        border-radius: 999px;
        margin-bottom: 12px;
        position: relative;
        z-index: 1;
    }
    .le-badge.le-dyn { animation: le-pulse 1.6s ease-in-out infinite; }
    @@keyframes le-pulse {
        0%,100% { transform: scale(1); }
        50% { transform: scale(1.04); }
    }
    .le-discount {
        display: inline-block;
        margin-left: 8px;
        background: var(--le-accent);
        color: #111;
        font-weight: 800;
        font-size: 12px;
        padding: 2px 8px;
        border-radius: 6px;
        vertical-align: middle;
        position: relative;
        z-index: 1;
    }
    .le-title {
        margin: 0 0 6px;
        font-size: var(--le-title-size);
        font-weight: var(--le-title-weight);
        color: var(--le-title);
        position: relative;
        z-index: 1;
        word-break: break-word;
    }
    .le-message {
        font-size: var(--le-msg-size);
        color: var(--le-message);
        margin-bottom: 12px;
        position: relative;
        z-index: 1;
    }
    .le-scarcity {
        margin: 6px 0 12px;
        font-size: 13px;
        color: var(--le-message);
        position: relative;
        z-index: 1;
    }
    .le-scarcity strong { color: var(--le-accent); }
    .le-progress {
        height: 6px;
        background: rgba(255,255,255,.14);
        border-radius: 99px;
        overflow: hidden;
        margin: 0 0 14px;
        position: relative;
        z-index: 1;
    }
    .le-progress > i {
        display: block;
        height: 100%;
        background: linear-gradient(90deg, var(--le-accent), var(--le-accent-light));
        border-radius: 99px;
        transition: width .5s ease;
    }

    /* ===== TIMER: gap uniforme + larghezza min box funzionante ===== */
    .le-countdown {
        display: flex;
        justify-content: center;
        align-items: stretch;
        gap: var(--le-timer-gap);
        margin: 4px 0 16px;
        position: relative;
        z-index: 1;
        flex-wrap: nowrap;
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }
    .le-layout-boxed .le-countdown {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: var(--le-timer-gap);
        max-width: min(100%, calc(var(--le-box-min-w) * 4 + var(--le-timer-gap) * 3));
        margin-left: auto;
        margin-right: auto;
    }
    .le-layout-minimal .le-time-box {
        background: transparent !important;
        border: none !important;
        min-width: 0 !important;
        width: auto !important;
        flex: 0 0 auto !important;
        padding: 0 4px !important;
    }
    .le-layout-minimal .le-time-box small { display: none; }

    .le-time-box {
        /* Slider "Larghezza min box" controlla queste 3 proprietà */
        flex: 0 0 var(--le-box-min-w);
        width: var(--le-box-min-w);
        min-width: var(--le-box-min-w);
        box-sizing: border-box;
        background: var(--le-box-bg);
        border: 1px solid var(--le-box-border);
        border-radius: var(--le-box-radius);
        padding: var(--le-box-pad) 4px 6px;
        text-align: center;
    }
    .le-layout-boxed .le-time-box {
        flex: unset;
        width: auto;
        min-width: 0;
    }
    .le-time-box span {
        display: block;
        font-size: var(--le-digit-size);
        font-weight: 800;
        line-height: 1;
        color: var(--le-digit);
        font-variant-numeric: tabular-nums;
    }
    .le-time-box small {
        display: block;
        margin-top: 4px;
        font-size: var(--le-label-size);
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--le-label);
    }

    .le-cta {
        position: relative;
        display: inline-block;
        background: linear-gradient(90deg, var(--le-cta-bg-start), var(--le-cta-bg-end));
        color: var(--le-cta-text) !important;
        font-weight: var(--le-cta-weight);
        font-size: var(--le-cta-size);
        padding: var(--le-cta-py) var(--le-cta-px);
        border-radius: var(--le-cta-radius);
        text-decoration: none !important;
        z-index: 1;
        max-width: 100%;
        box-sizing: border-box;
        text-align: center;
    }
    .le-cta.le-disabled {
        opacity: .45;
        pointer-events: none;
        cursor: not-allowed;
    }
    .le-tpl-minimal .le-card { box-shadow: 0 1px 3px rgba(0,0,0,.08); }
    .le-tpl-neon .le-time-box span { text-shadow: 0 0 16px color-mix(in srgb, var(--le-accent) 80%, transparent); }
    .le-tpl-soft .le-card { box-shadow: 0 8px 32px rgba(0,0,0,.08); }
    .le-compact .le-card { padding: 16px 18px; }
    .le-compact .le-title { font-size: 16px; }
    .le-card--product { padding: calc(var(--le-card-pad-t) * 0.7) var(--le-card-pad-s) calc(var(--le-card-pad-b) * 0.75); }
    #le-social-toast {
        position: fixed; left: 16px; bottom: 16px; z-index: 99999;
        max-width: 320px; background: #111; color: #fff; border-radius: 12px;
        padding: 12px 14px; font-size: 13px; box-shadow: 0 10px 30px rgba(0,0,0,.35);
        opacity: 0; transform: translateY(12px); transition: .35s ease; pointer-events: none;
        border: 1px solid rgba(255,255,255,.12);
    }
    #le-social-toast.on { opacity: 1; transform: translateY(0); }

    @@media (max-width: 480px) {
        .le-card {
            padding: 16px 14px 14px;
            border-radius: calc(var(--le-card-radius) * 0.75);
        }
        .le-card.le-has-img { min-height: 160px; }
        .le-badge { font-size: 10px; padding: 4px 10px; letter-spacing: 1px; margin-bottom: 8px; }
        .le-title { font-size: 16px; margin-bottom: 4px; }
        .le-message { font-size: 13px; margin-bottom: 8px; }
        .le-scarcity { font-size: 12px; margin: 4px 0 8px; }
        .le-progress { margin-bottom: 10px; }
        .le-countdown { gap: 6px; margin: 2px 0 12px; }
        .le-layout-boxed .le-countdown { max-width: 100%; gap: 6px; }
        /* mobile: box uguali, possono restringersi se non c'è spazio */
        .le-time-box {
            flex: 1 1 0;
            width: auto;
            min-width: 0;
            padding: 6px 2px 5px;
        }
        .le-time-box span { font-size: 18px; }
        .le-time-box small { font-size: 8px; letter-spacing: 0.5px; margin-top: 2px; }
        .le-cta { font-size: 13px; padding: 10px 18px; }
    }
</style>

<div class="le-wrap @layoutClass @templateClass">
@foreach (var offer in offers)
{
    var style = offer.Style ?? s;
    var endDateJs = offer.EndDateUtc.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ss.fffZ");
    var badgeText = offer.UseDynamicBadge && !string.IsNullOrEmpty(offer.DynamicBadgeText)
        ? offer.DynamicBadgeText
        : style.BadgeText;
    var useImg = Model.UseProductImageAsBackground && !string.IsNullOrEmpty(offer.ProductImageUrl);
    var bgStyle = useImg ? $"background-image:url('{offer.ProductImageUrl}');" : "";
    var progressWidth = offer.ProgressPercent.ToString(CultureInfo.InvariantCulture);
    var isProduct = Model.IsProductPage;

    <div class="le-card @(isProduct ? "le-card--product" : "") @(useImg ? "le-has-img" : "")"
         style="@bgStyle"
         data-product-id="@offer.ProductId"
         data-end="@endDateJs"
         data-blocked="@(offer.BlockPurchase ? "1" : "0")">

        @if (style.ShowBadge || offer.UseDynamicBadge)
        {
            <span class="le-badge @(offer.UseDynamicBadge ? "le-dyn" : "")">@badgeText</span>
        }
        @if (offer.DiscountPercentage > 0)
        {
            <span class="le-discount">-@((int)offer.DiscountPercentage)%</span>
        }
        @if (style.ShowTitle && !isProduct)
        {
            <h3 class="le-title">@offer.ProductName</h3>
        }
        @if (style.ShowMessage)
        {
            <div class="le-message">@offer.CustomMessage</div>
        }

        @if (offer.ShowRemainingStock || offer.ShowSoldCount)
        {
            <div class="le-scarcity">
                @if (offer.ShowRemainingStock && offer.InitialQuantity > 0)
                {
                    <span>Restano <strong>@offer.RemainingQuantity</strong> pezzi</span>
                }
                @if (offer.ShowSoldCount && offer.SoldCount > 0)
                {
                    <span>@(offer.ShowRemainingStock && offer.InitialQuantity > 0 ? " · " : "")<strong>@offer.SoldCount</strong> già venduti</span>
                }
            </div>
        }

        @if (offer.ShowProgressBar)
        {
            <div class="le-progress" title="@(offer.ProgressBarMode == 1 ? "Stock" : "Tempo")">
                <i style="width:@(progressWidth)%"></i>
            </div>
        }

        <div class="le-countdown"
             data-end="@endDateJs"
             data-expired="@(style.ExpiredText ?? "Offerta scaduta!")"
             data-product-id="@offer.ProductId">
            <div class="le-time-box"><span class="days">00</span><small>@(style.DaysLabel ?? "Giorni")</small></div>
            <div class="le-time-box"><span class="hours">00</span><small>@(style.HoursLabel ?? "Ore")</small></div>
            <div class="le-time-box"><span class="minutes">00</span><small>@(style.MinutesLabel ?? "Min")</small></div>
            <div class="le-time-box"><span class="seconds">00</span><small>@(style.SecondsLabel ?? "Sec")</small></div>
        </div>

        @if (!isProduct && style.ShowCta)
        {
            if (offer.BlockPurchase || offer.IsExpired || offer.IsSoldOut)
            {
                <span class="le-cta le-disabled">@(offer.IsSoldOut ? "Sold out" : (style.ExpiredText ?? "Scaduto"))</span>
            }
            else
            {
                <a href="@offer.ProductUrl" class="le-cta">@(style.CtaText ?? "Vedi offerta")</a>
            }
        }
    </div>
}
</div>

@if (Model.EnableSocialProof)
{
    <div id="le-social-toast" aria-live="polite"></div>
}

@await Html.PartialAsync("~/Plugins/Widgets.LimitedEdition/Views/Shared/_CountdownScript.cshtml")

<script>
(function () {
    var serverUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ServerCountdownUrl ?? ""));
    var socialUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SocialProofFeedUrl ?? ""));
    var enableServer = @(Model.EnableServerCountdown ? "true" : "false");
    var enableSound = @(Model.EnableLastHourSound ? "true" : "false");
    var enableSocial = @(Model.EnableSocialProof ? "true" : "false");
    var socialInterval = @(Model.SocialProofIntervalSeconds > 0 ? Model.SocialProofIntervalSeconds : 12) * 1000;

    if (enableServer && serverUrl) {
        document.querySelectorAll('.le-countdown[data-product-id]').forEach(function (box) {
            var pid = box.getAttribute('data-product-id');
            if (!pid) return;
            fetch(serverUrl + '?productId=' + encodeURIComponent(pid))
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (!data || !data.success || !data.endDateUtc) return;
                    box.setAttribute('data-end', data.endDateUtc);
                    var card = box.closest('.le-card');
                    if (card && data.progressPercent != null) {
                        var bar = card.querySelector('.le-progress > i');
                        if (bar) bar.style.width = data.progressPercent + '%';
                    }
                }).catch(function () {});
        });
    }

    if (enableSound) {
        var audioCtx;
        function beep() {
            try {
                audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
                var o = audioCtx.createOscillator();
                var g = audioCtx.createGain();
                o.connect(g); g.connect(audioCtx.destination);
                o.frequency.value = 880;
                g.gain.value = 0.03;
                o.start();
                setTimeout(function () { o.stop(); }, 60);
            } catch (e) {}
        }
        setInterval(function () {
            document.querySelectorAll('.le-countdown[data-end]').forEach(function (box) {
                var end = new Date(box.getAttribute('data-end')).getTime();
                var diff = end - Date.now();
                if (diff > 0 && diff < 3600000) beep();
            });
        }, 60000);
    }

    document.querySelectorAll('.le-card[data-blocked="1"]').forEach(function () {
        document.querySelectorAll('button[id*="add-to-cart"], .add-to-cart-button').forEach(function (btn) {
            btn.disabled = true;
            btn.classList.add('disabled');
            btn.title = 'Edizione non più disponibile';
        });
    });

    if (enableSocial && socialUrl) {
        var toast = document.getElementById('le-social-toast');
        var queue = [];
        var idx = 0;
        function showNext() {
            if (!toast || !queue.length) return;
            var item = queue[idx % queue.length];
            idx++;
            var verb = item.eventType === 'purchase' ? 'ha acquistato' :
                       item.eventType === 'viewing' ? 'sta guardando' : 'ha aggiunto al carrello';
            toast.textContent = (item.city ? item.city + ' · ' : '') + verb + ' ' + (item.productName || 'un prodotto') +
                (item.minutesAgo != null ? ' · ' + item.minutesAgo + ' min fa' : '');
            toast.classList.add('on');
            setTimeout(function () { toast.classList.remove('on'); }, 4200);
        }
        fetch(socialUrl + '?take=10')
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (!data || !data.items) return;
                queue = data.items;
                if (queue.length) {
                    setTimeout(showNext, 2500);
                    setInterval(showNext, socialInterval);
                }
            }).catch(function () {});
    }
})();
</script>
