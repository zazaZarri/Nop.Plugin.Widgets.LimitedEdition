@using System.Linq
@model Nop.Plugin.Widgets.LimitedEdition.Models.HomepageOffersModel

@{
    var s = Model.Style ?? new Nop.Plugin.Widgets.LimitedEdition.Models.StyleSettingsModel();
    var layoutClass = s.TimerLayout switch
    {
        Nop.Plugin.Widgets.LimitedEdition.Domain.TimerLayoutType.Boxed => "le-layout-boxed",
        Nop.Plugin.Widgets.LimitedEdition.Domain.TimerLayoutType.Minimal => "le-layout-minimal",
        _ => "le-layout-horizontal"
    };
}

<style>
    .le-wrap {
        --le-accent: @s.AccentColor;
        --le-accent-light: @s.AccentColorLight;
        --le-bg-start: @s.CardBackgroundStart;
        --le-bg-mid: @s.CardBackgroundMid;
        --le-bg-end: @s.CardBackgroundEnd;
        --le-border: @s.BorderColor;
        --le-title: @s.TitleColor;
        --le-message: @s.MessageColor;
        --le-badge-text: @s.BadgeTextColor;
        --le-badge-bg-start: @s.BadgeBackgroundStart;
        --le-badge-bg-end: @s.BadgeBackgroundEnd;
        --le-digit: @s.TimerDigitColor;
        --le-label: @s.TimerLabelColor;
        --le-box-bg: @s.TimerBoxBackground;
        --le-box-border: @s.TimerBoxBorderColor;
        --le-cta-bg-start: @s.CtaBackgroundStart;
        --le-cta-bg-end: @s.CtaBackgroundEnd;
        --le-cta-text: @s.CtaTextColor;
        --le-digit-size: @(s.TimerDigitFontSize)px;
        --le-label-size: @(s.TimerLabelFontSize)px;
        --le-box-min-w: @(s.TimerBoxMinWidth)px;
        --le-box-radius: @(s.TimerBoxBorderRadius)px;
        --le-box-pad: @(s.TimerBoxPadding)px;
        --le-timer-gap: @(s.TimerGap)px;
        --le-card-radius: @(s.CardBorderRadius)px;
        --le-card-pad-t: @(s.CardPaddingTop)px;
        --le-card-pad-s: @(s.CardPaddingSide)px;
        --le-card-pad-b: @(s.CardPaddingBottom)px;
        --le-card-margin-b: @(s.CardMarginBottom)px;
        --le-card-border-w: @(s.CardBorderWidth)px;
        --le-card-align: @s.CardTextAlign;
        --le-title-size: @(s.TitleFontSize)px;
        --le-title-weight: @s.TitleFontWeight;
        --le-msg-size: @(s.MessageFontSize)px;
        --le-badge-size: @(s.BadgeFontSize)px;
        --le-badge-weight: @s.BadgeFontWeight;
        --le-badge-ls: @(s.BadgeLetterSpacing)px;
        --le-badge-py: @(s.BadgePaddingY)px;
        --le-badge-px: @(s.BadgePaddingX)px;
        --le-cta-size: @(s.CtaFontSize)px;
        --le-cta-weight: @s.CtaFontWeight;
        --le-cta-py: @(s.CtaPaddingY)px;
        --le-cta-px: @(s.CtaPaddingX)px;
        --le-cta-radius: @(s.CtaBorderRadius)px;
        font-family: inherit;
        --le-font: @s.FontFamily;
        font-family: var(--le-font);
    }

    .le-card {
        position: relative;
        background: linear-gradient(145deg, var(--le-bg-start) 0%, var(--le-bg-mid) 55%, var(--le-bg-end) 100%);
        border: var(--le-card-border-w) solid var(--le-border);
        border-radius: var(--le-card-radius);
        padding: var(--le-card-pad-t) var(--le-card-pad-s) var(--le-card-pad-b);
        margin-bottom: var(--le-card-margin-b);
        text-align: var(--le-card-align);
        overflow: hidden;
        box-shadow: 0 0 0 1px color-mix(in srgb, var(--le-accent) 8%, transparent),
                    0 12px 40px rgba(0, 0, 0, 0.45),
                    0 0 28px color-mix(in srgb, var(--le-accent) 15%, transparent);
        @if (s.EnableGlowAnimation)
        {
            <text>animation: le-glow 3s ease-in-out infinite;</text>
        }
    }

    @@keyframes le-glow {
        0%, 100% { box-shadow: 0 0 0 1px color-mix(in srgb, var(--le-accent) 8%, transparent), 0 12px 40px rgba(0,0,0,.45), 0 0 18px color-mix(in srgb, var(--le-accent) 12%, transparent); }
        50%      { box-shadow: 0 0 0 1px color-mix(in srgb, var(--le-accent) 18%, transparent), 0 12px 40px rgba(0,0,0,.45), 0 0 34px color-mix(in srgb, var(--le-accent) 35%, transparent); }
    }

    .le-card::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(120deg, transparent 30%, color-mix(in srgb, var(--le-accent) 10%, transparent) 40%, transparent 67%);
        background-size: 220% 100%;
        pointer-events: none;
        @if (s.EnableSheenAnimation)
        {
            <text>animation: le-sheen 6s linear infinite;</text>
        }
        else
        {
            <text>display: none;</text>
        }
    }

    @@keyframes le-sheen {
        0%   { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }

    .le-badge {
        display: inline-block;
        font-size: var(--le-badge-size);
        font-weight: var(--le-badge-weight);
        letter-spacing: var(--le-badge-ls);
        text-transform: uppercase;
        color: var(--le-badge-text);
        background: linear-gradient(90deg, var(--le-badge-bg-start), var(--le-badge-bg-end));
        padding: var(--le-badge-py) var(--le-badge-px);
        border-radius: 999px;
        margin-bottom: 14px;
        box-shadow: 0 2px 10px color-mix(in srgb, var(--le-accent) 50%, transparent);
        position: relative;
        z-index: 1;
    }

    .le-title {
        margin: 0 0 6px;
        font-size: var(--le-title-size);
        font-weight: var(--le-title-weight);
        color: var(--le-title);
        letter-spacing: .3px;
        position: relative;
        z-index: 1;
    }

    .le-message {
        font-size: var(--le-msg-size);
        color: var(--le-message);
        margin-bottom: 18px;
        position: relative;
        z-index: 1;
    }

    .le-countdown {
        display: flex;
        justify-content: center;
        gap: var(--le-timer-gap);
        margin: 4px 0 20px;
        position: relative;
        z-index: 1;
        flex-wrap: wrap;
    }

    .le-layout-boxed .le-countdown {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        max-width: 320px;
        margin-left: auto;
        margin-right: auto;
    }

    .le-layout-minimal .le-time-box {
        background: transparent;
        border: none;
        min-width: auto;
        padding: 0 4px;
    }

    .le-layout-minimal .le-time-box small {
        display: none;
    }

    .le-layout-minimal .le-countdown::after {
        content: none;
    }

    .le-time-box {
        min-width: var(--le-box-min-w);
        background: var(--le-box-bg);
        border: 1px solid var(--le-box-border);
        border-radius: var(--le-box-radius);
        padding: var(--le-box-pad) 5px 6px;
    }

    .le-time-box span {
        display: block;
        font-size: var(--le-digit-size);
        font-weight: 800;
        line-height: 1;
        color: var(--le-digit);
        text-shadow: 0 0 12px color-mix(in srgb, var(--le-accent) 55%, transparent);
        font-variant-numeric: tabular-nums;
    }

    .le-time-box small {
        display: block;
        margin-top: 4px;
        font-size: var(--le-label-size);
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--le-label);
    }

    .le-cta {
        position: relative;
        display: inline-block;
        overflow: hidden;
        background: linear-gradient(90deg, var(--le-cta-bg-start), var(--le-cta-bg-end));
        color: var(--le-cta-text);
        font-weight: var(--le-cta-weight);
        font-size: var(--le-cta-size);
        letter-spacing: .4px;
        padding: var(--le-cta-py) var(--le-cta-px);
        border-radius: var(--le-cta-radius);
        text-decoration: none;
        transition: transform .2s ease, box-shadow .2s ease;
        box-shadow: 0 6px 18px color-mix(in srgb, var(--le-accent) 35%, transparent);
        z-index: 1;
    }

    .le-cta:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 26px color-mix(in srgb, var(--le-accent) 55%, transparent);
        color: var(--le-cta-text);
    }

    .le-card--product {
        padding: calc(var(--le-card-pad-t) * 0.7) var(--le-card-pad-s) calc(var(--le-card-pad-b) * 0.75);
    }

    .le-card--product .le-countdown {
        margin-bottom: 4px;
    }
</style>

@if (Model.IsProductPage)
{
    var offer = Model.Offers?.FirstOrDefault();
    if (offer != null)
    {
        var endDateJs = offer.EndDateUtc.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ss.fffZ");
        var style = offer.Style ?? s;

        <div class="le-wrap @layoutClass">
            <div class="le-card le-card--product">
                @if (style.ShowBadge)
                {
                    <span class="le-badge">@style.BadgeText</span>
                }
                @if (style.ShowMessage)
                {
                    <div class="le-message">@offer.CustomMessage</div>
                }

                <div class="le-countdown"
                     data-end="@endDateJs"
                     data-expired="@style.ExpiredText">
                    <div class="le-time-box"><span class="days">00</span><small>@style.DaysLabel</small></div>
                    <div class="le-time-box"><span class="hours">00</span><small>@style.HoursLabel</small></div>
                    <div class="le-time-box"><span class="minutes">00</span><small>@style.MinutesLabel</small></div>
                    <div class="le-time-box"><span class="seconds">00</span><small>@style.SecondsLabel</small></div>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="le-wrap @layoutClass">
        @foreach (var offer in Model.Offers ?? Enumerable.Empty<Nop.Plugin.Widgets.LimitedEdition.Models.PublicInfoModel>())
        {
            var endDateJs = offer.EndDateUtc.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ss.fffZ");
            var style = offer.Style ?? s;

            <div class="le-card">
                @if (style.ShowBadge)
                {
                    <span class="le-badge">@style.BadgeText</span>
                }
                @if (style.ShowTitle)
                {
                    <h3 class="le-title">@offer.ProductName</h3>
                }
                @if (style.ShowMessage)
                {
                    <div class="le-message">@offer.CustomMessage</div>
                }

                <div class="le-countdown"
                     data-end="@endDateJs"
                     data-expired="@style.ExpiredText">
                    <div class="le-time-box"><span class="days">00</span><small>@style.DaysLabel</small></div>
                    <div class="le-time-box"><span class="hours">00</span><small>@style.HoursLabel</small></div>
                    <div class="le-time-box"><span class="minutes">00</span><small>@style.MinutesLabel</small></div>
                    <div class="le-time-box"><span class="seconds">00</span><small>@style.SecondsLabel</small></div>
                </div>

                @if (style.ShowCta)
                {
                    <a href="@offer.ProductUrl" class="le-cta">@style.CtaText</a>
                }
            </div>
        }
    </div>
}

@await Html.PartialAsync("~/Plugins/Widgets.LimitedEdition/Views/Shared/_CountdownScript.cshtml")
