@using System.Linq
@model Nop.Plugin.Widgets.LimitedEdition.Models.HomepageOffersModel

@{
    var s = Model?.Style;
    if (s == null || !s.EnableCartPopup || Model?.Offers == null || !Model.Offers.Any())
    {
        return;
    }

    var popupTpl = Model.PopupTemplateId switch
    {
        1 => "le-pop-minimal",
        2 => "le-pop-neon",
        3 => "le-pop-soft",
        _ => "le-pop-classic"
    };

    var accent = string.IsNullOrWhiteSpace(s.AccentColor) ? "#d4af37" : s.AccentColor;
    var accentLight = string.IsNullOrWhiteSpace(s.AccentColorLight) ? "#f4e5a1" : s.AccentColorLight;
    var bgStart = string.IsNullOrWhiteSpace(s.CardBackgroundStart) ? "#0b0b0f" : s.CardBackgroundStart;
    var bgMid = string.IsNullOrWhiteSpace(s.CardBackgroundMid) ? "#1a1a22" : s.CardBackgroundMid;
    var bgEnd = string.IsNullOrWhiteSpace(s.CardBackgroundEnd) ? "#0b0b0f" : s.CardBackgroundEnd;
    var border = string.IsNullOrWhiteSpace(s.BorderColor) ? "rgba(212,175,55,0.45)" : s.BorderColor;
    var titleColor = string.IsNullOrWhiteSpace(s.TitleColor) ? "#ffffff" : s.TitleColor;
    var msgColor = string.IsNullOrWhiteSpace(s.MessageColor) ? "rgba(255,255,255,0.72)" : s.MessageColor;
    var badgeTextColor = string.IsNullOrWhiteSpace(s.BadgeTextColor) ? "#1a1a22" : s.BadgeTextColor;
    var badgeBg1 = string.IsNullOrWhiteSpace(s.BadgeBackgroundStart) ? "#f4e5a1" : s.BadgeBackgroundStart;
    var badgeBg2 = string.IsNullOrWhiteSpace(s.BadgeBackgroundEnd) ? "#d4af37" : s.BadgeBackgroundEnd;
    var ctaBg1 = string.IsNullOrWhiteSpace(s.CtaBackgroundStart) ? "#d4af37" : s.CtaBackgroundStart;
    var ctaBg2 = string.IsNullOrWhiteSpace(s.CtaBackgroundEnd) ? "#f4e5a1" : s.CtaBackgroundEnd;
    var ctaText = string.IsNullOrWhiteSpace(s.CtaTextColor) ? "#1a1a22" : s.CtaTextColor;
    var font = string.IsNullOrWhiteSpace(s.FontFamily) ? "inherit" : s.FontFamily;
    var radius = s.CardBorderRadius > 0 ? s.CardBorderRadius : 18;
    var maxW = s.PopupModalMaxWidth > 0 ? s.PopupModalMaxWidth : 420;
    var delay = s.PopupShowDelayMs >= 0 ? s.PopupShowDelayMs : 500;
    var dur = s.PopupAnimationDurationMs > 0 ? s.PopupAnimationDurationMs : 350;
    var overlayOp = (s.PopupOverlayOpacity > 0 ? s.PopupOverlayOpacity : 72) / 100.0;
    var blur = s.PopupOverlayBlurPx >= 0 ? s.PopupOverlayBlurPx : 6;
    var anim = s.PopupAnimationType;
    var badgeLabel = string.IsNullOrWhiteSpace(s.BadgeText) ? "⚡ Edizione Limitata" : s.BadgeText;
    var ctaLabel = string.IsNullOrWhiteSpace(s.CtaText) ? "Vedi" : s.CtaText;
    var title = string.IsNullOrWhiteSpace(s.PopupTitle) ? "Non perderti l'edizione limitata!" : s.PopupTitle;
    var subtitle = string.IsNullOrWhiteSpace(s.PopupSubtitle) ? "Questi prodotti esclusivi stanno per scadere" : s.PopupSubtitle;
    var continueText = string.IsNullOrWhiteSpace(s.PopupContinueText) ? "Continua lo shopping" : s.PopupContinueText;
}

<style>
#le-cart-overlay {
    position: fixed; inset: 0; z-index: 9998;
    background: rgba(0,0,0,@overlayOp.ToString(System.Globalization.CultureInfo.InvariantCulture));
    backdrop-filter: blur(@(blur)px);
    opacity: 0; visibility: hidden;
    transition: opacity @(dur)ms ease, visibility @(dur)ms ease;
}
#le-cart-overlay.is-visible { opacity: 1; visibility: visible; }

#le-cart-modal {
    position: fixed; top: 50%; left: 50%; z-index: 9999;
    width: min(@(maxW)px, calc(100% - 28px));
    background: linear-gradient(145deg, @bgStart 0%, @bgMid 55%, @bgEnd 100%);
    border: 1px solid @border;
    border-radius: @(radius)px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.55);
    opacity: 0; visibility: hidden;
    font-family: @font;
    overflow: hidden;
    transition: opacity @(dur)ms ease, transform @(dur)ms ease, visibility @(dur)ms ease;
@if (anim == 0)
{
    <text>transform: translate(-50%, -50%);</text>
}
else if (anim == 2)
{
    <text>transform: translate(-50%, -30%);</text>
}
else if (anim == 3)
{
    <text>transform: translate(-50%, -70%);</text>
}
else
{
    <text>transform: translate(-50%, -50%) scale(0.92);</text>
}
}
#le-cart-modal.is-visible {
    opacity: 1; visibility: visible;
    transform: translate(-50%, -50%) scale(1);
}
@if (s.PopupEnableGlow)
{
    <text>
    #le-cart-modal { animation: le-pop-glow 3s ease-in-out infinite; }
    @@keyframes le-pop-glow {
        0%,100% { box-shadow: 0 20px 50px rgba(0,0,0,0.55), 0 0 20px @(accent)44; }
        50% { box-shadow: 0 20px 50px rgba(0,0,0,0.55), 0 0 36px @(accent)88; }
    }
    </text>
}

.le-modal-inner { position: relative; z-index: 1; padding: 28px 24px 22px; text-align: center; }
.le-close {
    position: absolute; top: 12px; right: 12px; width: 32px; height: 32px;
    border: 1px solid @(accent)55; background: @(accent)18; border-radius: 50%;
    color: @accentLight; cursor: pointer; display: flex; align-items: center; justify-content: center;
}
.le-close svg { width: 14px; height: 14px; }
.le-badge {
    display: inline-block; font-size: 11px; font-weight: 800; letter-spacing: 2px;
    text-transform: uppercase; color: @badgeTextColor;
    background: linear-gradient(90deg, @badgeBg1, @badgeBg2);
    padding: 5px 14px; border-radius: 999px; margin-bottom: 12px;
}
.le-title { margin: 0 0 6px; font-size: 22px; font-weight: 700; color: @titleColor; }
.le-message { font-size: 14px; color: @msgColor; margin: 0 0 18px; }
.le-products { display: flex; flex-direction: column; gap: 10px; margin-bottom: 18px; text-align: left; }
.le-product {
    display: flex; align-items: center; gap: 12px; padding: 12px 14px;
    background: @(accent)14; border: 1px solid @(accent)44; border-radius: 12px;
}
.le-product-name { margin: 0 0 3px; font-size: 14px; font-weight: 600; color: @titleColor; }
.le-product-expiry { font-size: 12px; color: @accent; }
.le-product-cta {
    margin-left: auto; flex-shrink: 0; padding: 7px 12px;
    background: linear-gradient(90deg, @ctaBg1, @ctaBg2); color: @ctaText !important;
    font-size: 12px; font-weight: 700; border-radius: 999px; text-decoration: none !important;
}
.le-continue {
    display: block; width: 100%; padding: 12px 20px; background: transparent;
    border: 1px solid @(accent)55; border-radius: 999px; color: rgba(255,255,255,0.75);
    font-size: 13px; font-weight: 600; cursor: pointer; font-family: @font;
}
.le-continue:hover { color: @accentLight; border-color: @accent; }
</style>

<div id="le-cart-overlay" class="@popupTpl"></div>
<div id="le-cart-modal" class="@popupTpl" role="dialog" aria-modal="true">
    <button type="button" class="le-close" id="le-cart-close" aria-label="Chiudi">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
    </button>
    <div class="le-modal-inner">
        @if (s.PopupShowBadge)
        {
            <span class="le-badge">@badgeLabel</span>
        }
        <h2 class="le-title">@title</h2>
        <p class="le-message">@subtitle</p>
        @if (s.PopupShowProductList)
        {
            <div class="le-products">
                @foreach (var offer in Model.Offers)
                {
                    <div class="le-product">
                        <div>
                            <p class="le-product-name">@offer.ProductName</p>
                            <span class="le-product-expiry">Scade il @offer.EndDateUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <a href="@offer.ProductUrl" class="le-product-cta">@ctaLabel</a>
                    </div>
                }
            </div>
        }
        <button type="button" class="le-continue" id="le-cart-continue">@continueText</button>
    </div>
</div>

<script>
(function () {
    var once = @(s.PopupOncePerSession ? "true" : "false");
    if (once && sessionStorage.getItem('leCartPopupShown')) return;

    var overlay = document.getElementById('le-cart-overlay');
    var modal = document.getElementById('le-cart-modal');
    var delay = @delay;
    var closeOverlay = @(s.PopupCloseOnOverlayClick ? "true" : "false");
    var closeEsc = @(s.PopupCloseOnEscape ? "true" : "false");

    function openModal() {
        overlay.classList.add('is-visible');
        modal.classList.add('is-visible');
        document.body.style.overflow = 'hidden';
        if (once) sessionStorage.setItem('leCartPopupShown', '1');
    }
    function closeModal() {
        overlay.classList.remove('is-visible');
        modal.classList.remove('is-visible');
        document.body.style.overflow = '';
    }

    setTimeout(openModal, delay);

    document.getElementById('le-cart-close').addEventListener('click', closeModal);
    document.getElementById('le-cart-continue').addEventListener('click', closeModal);
    if (closeOverlay) overlay.addEventListener('click', closeModal);
    if (closeEsc) {
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeModal();
        });
    }
})();
</script>