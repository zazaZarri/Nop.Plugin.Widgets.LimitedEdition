@model ConfigurationModel

<div class="form-group row">
    <div class="col-md-3">
        <nop-label asp-for="BackgroundColor" />
    </div>
    <div class="col-md-9">
        <nop-editor asp-for="BackgroundColor" />
        <span asp-validation-for="BackgroundColor"></span>
    </div>
</div>

<div class="form-group row">
    <div class="col-md-3">
        <nop-label asp-for="TextColor" />
    </div>
    <div class="col-md-9">
        <nop-editor asp-for="TextColor" />
        <span asp-validation-for="TextColor"></span>
    </div>
</div>

<div class="form-group row">
    <div class="col-md-3">
        <nop-label asp-for="CustomMessage" />
    </div>
    <div class="col-md-9">
        <nop-editor asp-for="CustomMessage" asp-template="MultiLine" />
        <span asp-validation-for="CustomMessage"></span>
    </div>
</div>

<div class="form-group row">
    <div class="col-md-3">
        <nop-label asp-for="TimerLayoutId" />
    </div>
    <div class="col-md-9">
        <nop-select asp-for="TimerLayoutId" asp-items="@(new SelectList(new[]
        {
            new { Id = 0, Name = "Horizontal" },
            new { Id = 1, Name = "Boxed" },
            new { Id = 2, Name = "Minimal" }
        }, "Id", "Name"))" />
        <span asp-validation-for="TimerLayoutId"></span>
    </div>
</div>

<div class="form-group row">
    <div class="col-md-3">
        <nop-label asp-for="HideProductWhenExpired" />
    </div>
    <div class="col-md-9">
        <nop-editor asp-for="HideProductWhenExpired" />
        <span asp-validation-for="HideProductWhenExpired"></span>
    </div>
</div>