@model ConfigurationModel

<style>
    .le-admin-preview-wrap {
        position: sticky;
        top: 70px;
        background: #f4f4f5;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 20px;
    }
    .le-admin-preview-wrap h5 {
        margin: 0 0 12px;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #666;
    }
    #le-live-preview.le-wrap {
        --le-accent: #d4af37;
        --le-accent-light: #f4e5a1;
        --le-bg-start: #0b0b0f;
        --le-bg-mid: #1a1a22;
        --le-bg-end: #0b0b0f;
        --le-border: rgba(212, 175, 55, 0.45);
        --le-title: #ffffff;
        --le-message: rgba(255, 255, 255, 0.72);
        --le-badge-text: #1a1a22;
        --le-badge-bg-start: #f4e5a1;
        --le-badge-bg-end: #d4af37;
        --le-digit: #f4e5a1;
        --le-label: rgba(255, 255, 255, 0.45);
        --le-box-bg: rgba(212, 175, 55, 0.08);
        --le-box-border: rgba(212, 175, 55, 0.35);
        --le-cta-bg-start: #d4af37;
        --le-cta-bg-end: #f4e5a1;
        --le-cta-text: #1a1a22;
        --le-digit-size: 26px;
        --le-label-size: 9px;
        --le-box-min-w: 58px;
        --le-box-radius: 10px;
        --le-box-pad: 8px;
        --le-timer-gap: 10px;
        --le-card-radius: 16px;
        --le-card-pad-t: 28px;
        --le-card-pad-s: 24px;
        --le-card-pad-b: 24px;
        --le-card-margin-b: 0;
        --le-card-border-w: 1px;
        --le-card-align: center;
        --le-title-size: 22px;
        --le-title-weight: 700;
        --le-msg-size: 14px;
        --le-badge-size: 11px;
        --le-badge-weight: 800;
        --le-badge-ls: 2px;
        --le-badge-py: 5px;
        --le-badge-px: 14px;
        --le-cta-size: 14px;
        --le-cta-weight: 700;
        --le-cta-py: 11px;
        --le-cta-px: 28px;
        --le-cta-radius: 999px;
        --le-font: inherit;
        font-family: var(--le-font);
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }
    #le-live-preview .le-card {
        position: relative;
        background: linear-gradient(145deg, var(--le-bg-start) 0%, var(--le-bg-mid) 55%, var(--le-bg-end) 100%);
        border: var(--le-card-border-w) solid var(--le-border);
        border-radius: var(--le-card-radius);
        padding: var(--le-card-pad-t) var(--le-card-pad-s) var(--le-card-pad-b);
        text-align: var(--le-card-align);
        overflow: hidden;
        box-shadow: 0 12px 40px rgba(0,0,0,.35);
        font-family: var(--le-font);
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }
    #le-live-preview .le-badge {
        display: inline-block;
        font-size: var(--le-badge-size);
        font-weight: var(--le-badge-weight);
        letter-spacing: var(--le-badge-ls);
        text-transform: uppercase;
        color: var(--le-badge-text);
        background: linear-gradient(90deg, var(--le-badge-bg-start), var(--le-badge-bg-end));
        padding: var(--le-badge-py) var(--le-badge-px);
        border-radius: 999px;
        margin-bottom: 12px;
    }
    #le-live-preview .le-title {
        margin: 0 0 6px;
        font-size: var(--le-title-size);
        font-weight: var(--le-title-weight);
        color: var(--le-title);
        word-break: break-word;
    }
    #le-live-preview .le-message {
        font-size: var(--le-msg-size);
        color: var(--le-message);
        margin-bottom: 12px;
    }
    #le-live-preview .le-countdown {
        display: flex;
        justify-content: center;
        align-items: stretch;
        gap: var(--le-timer-gap);
        margin: 4px 0 16px;
        flex-wrap: nowrap;
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }
    #le-live-preview.le-layout-boxed .le-countdown {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: var(--le-timer-gap);
        max-width: min(100%, calc(var(--le-box-min-w) * 4 + var(--le-timer-gap) * 3));
        margin-left: auto;
        margin-right: auto;
    }
    #le-live-preview.le-layout-minimal .le-time-box {
        background: transparent !important;
        border: none !important;
        min-width: 0 !important;
        width: auto !important;
        flex: 0 0 auto !important;
        padding: 0 4px !important;
    }
    #le-live-preview.le-layout-minimal .le-time-box small { display: none; }
    #le-live-preview .le-time-box {
        flex: 0 0 var(--le-box-min-w);
        width: var(--le-box-min-w);
        min-width: var(--le-box-min-w);
        box-sizing: border-box;
        background: var(--le-box-bg);
        border: 1px solid var(--le-box-border);
        border-radius: var(--le-box-radius);
        padding: var(--le-box-pad) 4px 6px;
        text-align: center;
    }
    #le-live-preview.le-layout-boxed .le-time-box {
        flex: unset;
        width: auto;
        min-width: 0;
    }
    #le-live-preview .le-time-box span {
        display: block;
        font-size: var(--le-digit-size);
        font-weight: 800;
        line-height: 1;
        color: var(--le-digit);
        font-variant-numeric: tabular-nums;
    }
    #le-live-preview .le-time-box small {
        display: block;
        margin-top: 4px;
        font-size: var(--le-label-size);
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--le-label);
    }
    #le-live-preview .le-cta {
        display: inline-block;
        background: linear-gradient(90deg, var(--le-cta-bg-start), var(--le-cta-bg-end));
        color: var(--le-cta-text) !important;
        font-weight: var(--le-cta-weight);
        font-size: var(--le-cta-size);
        padding: var(--le-cta-py) var(--le-cta-px);
        border-radius: var(--le-cta-radius);
        text-decoration: none !important;
        max-width: 100%;
        box-sizing: border-box;
        text-align: center;
    }
    #le-live-preview .le-scarcity {
        margin: 6px 0 12px;
        font-size: 13px;
        color: var(--le-message);
    }
    #le-live-preview .le-scarcity strong { color: var(--le-accent); }
    #le-live-preview .le-discount {
        display: inline-block;
        margin-left: 8px;
        background: var(--le-accent);
        color: #111;
        font-weight: 800;
        font-size: 12px;
        padding: 2px 8px;
        border-radius: 6px;
        vertical-align: middle;
    }
    #le-live-preview .le-progress {
        height: 6px;
        background: rgba(255,255,255,.14);
        border-radius: 99px;
        overflow: hidden;
        margin: 0 0 14px;
    }
    #le-live-preview .le-progress > i {
        display: block;
        height: 100%;
        width: 45%;
        background: linear-gradient(90deg, var(--le-accent), var(--le-accent-light));
        border-radius: 99px;
    }
    #le-live-preview .le-badge.le-dyn {
        animation: le-admin-pulse 1.6s ease-in-out infinite;
    }
    @@keyframes le-admin-pulse {
        0%,100% { transform: scale(1); }
        50% { transform: scale(1.04); }
    }
    #le-live-preview.le-tpl-story .le-card {
        min-height: 260px;
        background-size: cover;
        background-position: center;
        background-image: linear-gradient(180deg, rgba(0,0,0,.4), rgba(0,0,0,.75)),
            url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="400" height="300"><rect fill="%23333" width="400" height="300"/><text x="50%25" y="50%25" fill="%23999" text-anchor="middle" font-size="18">Product image</text></svg>');
    }
    #le-live-preview.le-tpl-minimal .le-card { box-shadow: 0 1px 3px rgba(0,0,0,.08); }
    #le-live-preview.le-tpl-neon .le-time-box span {
        text-shadow: 0 0 16px color-mix(in srgb, var(--le-accent) 80%, transparent);
    }
    #le-live-preview.le-tpl-soft .le-card { box-shadow: 0 8px 32px rgba(0,0,0,.08); }

    /* Responsive preview = frontend */
    .le-admin-preview-wrap.is-mobile-preview #le-live-preview .le-card {
        padding: 16px 14px 14px;
        border-radius: calc(var(--le-card-radius) * 0.75);
    }
    .le-admin-preview-wrap.is-mobile-preview #le-live-preview.le-tpl-story .le-card {
        min-height: 160px;
    }
    .le-admin-preview-wrap.is-mobile-preview #le-live-preview .le-badge {
        font-size: 10px;
        padding: 4px 10px;
        letter-spacing: 1px;
        margin-bottom: 8px;
    }
    .le-admin-preview-wrap.is-mobile-preview #le-live-preview .le-title {
        font-size: 16px;
        margin-bottom: 4px;
    }
    .le-admin-preview-wrap.is-mobile-preview #le-live-preview .le-message {
        font-size: 13px;
        margin-bottom: 8px;
    }
    .le-admin-preview-wrap.is-mobile-preview #le-live-preview .le-scarcity {
        font-size: 12px;
        margin: 4px 0 8px;
    }
    .le-admin-preview-wrap.is-mobile-preview #le-live-preview .le-progress {
        margin-bottom: 10px;
    }
    .le-admin-preview-wrap.is-mobile-preview #le-live-preview .le-countdown {
        gap: 6px;
        margin: 2px 0 12px;
        flex-wrap: nowrap;
    }
    .le-admin-preview-wrap.is-mobile-preview #le-live-preview.le-layout-boxed .le-countdown {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        max-width: 100%;
        gap: 6px;
    }
    .le-admin-preview-wrap.is-mobile-preview #le-live-preview .le-time-box {
        flex: 1 1 0;
        width: auto;
        min-width: 0;
        padding: 6px 2px 5px;
        border-radius: 8px;
    }
    .le-admin-preview-wrap.is-mobile-preview #le-live-preview .le-time-box span {
        font-size: 18px;
    }
    .le-admin-preview-wrap.is-mobile-preview #le-live-preview .le-time-box small {
        font-size: 8px;
        letter-spacing: 0.5px;
        margin-top: 2px;
    }
    .le-admin-preview-wrap.is-mobile-preview #le-live-preview .le-cta {
        font-size: 13px;
        padding: 10px 18px;
    }

    @@media (max-width: 991px) {
        #le-live-preview .le-card {
            padding: calc(var(--le-card-pad-t) * 0.75) calc(var(--le-card-pad-s) * 0.75) calc(var(--le-card-pad-b) * 0.75);
        }
        #le-live-preview .le-time-box { min-width: 0; }
        #le-live-preview .le-countdown { gap: calc(var(--le-timer-gap) * 0.7); }
        #le-live-preview.le-layout-boxed .le-countdown { max-width: 100%; }
    }
    .le-preview-sample {
        margin-top: 10px;
        padding: 10px;
        background: #fff;
        border: 1px dashed #ccc;
        border-radius: 6px;
        font-size: 12px;
    }
    .le-preview-sample label { font-weight: 600; margin-right: 6px; }
    .le-preview-sample input[type="number"] { width: 64px; display: inline-block; margin-right: 8px; }

    .le-settings-section {

        border: 1px solid #e5e5e5;
        border-radius: 6px;
        margin-bottom: 18px;
        overflow: hidden;
    }
    .le-settings-section > .section-header {
        background: #f8f9fa;
        padding: 10px 16px;
        font-weight: 600;
        cursor: pointer;
        user-select: none;
        border-bottom: 1px solid #e5e5e5;
    }
    .le-settings-section > .section-body { padding: 16px 12px 8px; }
    .le-color-row input[type="color"] {
        width: 42px;
        height: 34px;
        padding: 2px;
        border: 1px solid #ccc;
        border-radius: 4px;
        cursor: pointer;
        vertical-align: middle;
    }
    .le-color-row input[type="text"].le-color-hex,
    .le-color-row input.le-color-hex {
        width: 140px;
        display: inline-block;
        margin-left: 8px;
        vertical-align: middle;
    }
    .le-range-val {
        display: inline-block;
        min-width: 42px;
        margin-left: 8px;
        font-weight: 600;
        color: #555;
    }
    .le-field-label {
        font-weight: 600;
        padding-top: 7px;
    }
</style>

<!-- Google Fonts usati nel selettore -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Bebas+Neue&family=Inter:wght@400;600;700;800&family=Lato:wght@400;700;900&family=Montserrat:wght@400;600;700;800&family=Open+Sans:wght@400;600;700;800&family=Oswald:wght@400;600;700&family=Playfair+Display:wght@400;700&family=Poppins:wght@400;600;700;800&family=Raleway:wght@400;600;700;800&family=Roboto:wght@400;500;700;900&family=Rubik:wght@400;600;700&family=Source+Sans+3:wght@400;600;700&family=Space+Grotesk:wght@400;600;700&family=Work+Sans:wght@400;600;700&display=swap" rel="stylesheet" />

<input type="hidden" asp-for="SelectedCardTemplateId" id="SelectedCardTemplateId" />

<div class="row">
    <div class="col-md-7">

        <!-- TEMPLATE CARD -->
        <div class="le-settings-section" style="border-color:#d4af37;">
            <div class="section-header" style="background:linear-gradient(90deg,#f8f9fa,#fff8e7);">Template card</div>
            <div class="section-body" style="padding:16px 12px;">
                <p class="text-muted small mb-2">Ogni template ha stile e personalizzazioni <strong>indipendenti</strong>. Cambiando template carichi le sue impostazioni; salvando aggiorni solo quello selezionato.</p>
                <div class="form-group row mb-0">
                    <div class="col-md-4"><label class="le-field-label">Template attivo</label></div>
                    <div class="col-md-8">
                        <select id="CardTemplateSelect" class="form-control">
                            <option value="0">Classic — Gold luxury dark</option>
                            <option value="1">Minimal — Chiaro e pulito</option>
                            <option value="2">Neon — Cyber glow</option>
                            <option value="3">Soft — Pastel elegante</option>
                            <option value="4">Story — Full-bleed hero</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>


        <!-- FEATURES -->
        <div class="le-settings-section">
            <div class="section-header" data-toggle="collapse" data-target="#sec-features">Funzionalità avanzate</div>
            <div id="sec-features" class="section-body collapse show">
                <div class="form-group row">
                    <div class="col-md-6"><input asp-for="EnableSocialProof" /> <label for="EnableSocialProof">Social proof (toast acquisti)</label></div>
                    <div class="col-md-6"><input asp-for="SocialProofIncludeSimulated" /> <label for="SocialProofIncludeSimulated">Includi eventi simulati</label></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-4"><label class="le-field-label">Intervallo toast (sec)</label></div>
                    <div class="col-md-8"><input asp-for="SocialProofIntervalSeconds" class="form-control" type="number" min="5" max="120" /></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-6"><input asp-for="EnableDynamicBadges" /> <label for="EnableDynamicBadges">Badge dinamici</label></div>
                    <div class="col-md-6"><input asp-for="EnableLastHourSound" /> <label for="EnableLastHourSound">Suono ultima ora</label></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-4"><label class="le-field-label">Ore badge urgente</label></div>
                    <div class="col-md-2"><input asp-for="DynamicBadgeUrgentHours" class="form-control" type="number" /></div>
                    <div class="col-md-4"><label class="le-field-label">% stock basso</label></div>
                    <div class="col-md-2"><input asp-for="DynamicBadgeLowStockPercent" class="form-control" type="number" /></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-6"><input asp-for="EnableAbTest" /> <label for="EnableAbTest">A/B test template</label></div>
                    <div class="col-md-6"><input asp-for="EnableServerCountdown" /> <label for="EnableServerCountdown">Countdown server-side</label></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-4"><label class="le-field-label">Template A/B (csv id)</label></div>
                    <div class="col-md-8"><input asp-for="AbTestTemplateIds" class="form-control" placeholder="0,2,4" /></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-6"><input asp-for="EnableExpiryReminders" /> <label for="EnableExpiryReminders">Reminder email scadenza</label></div>
                    <div class="col-md-3"><label class="le-field-label">Ore prima</label></div>
                    <div class="col-md-3"><input asp-for="ReminderHoursBeforeExpiry" class="form-control" type="number" /></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-6"><input asp-for="CompactOnProductPage" /> <label for="CompactOnProductPage">Layout compatto product page</label></div>
                    <div class="col-md-6"><input asp-for="PreferStoryOnHomepageTop" /> <label for="PreferStoryOnHomepageTop">Forza Story in homepage top</label></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-6"><input asp-for="UseProductImageAsBackground" /> <label for="UseProductImageAsBackground">Usa immagine prodotto come sfondo card</label></div>
                    <div class="col-md-6"><span class="text-muted small">Se attivo, la foto prodotto diventa background (ideale con template Story).</span></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-6"><input asp-for="GlobalBlockPurchaseWhenExpired" /> <label for="GlobalBlockPurchaseWhenExpired">Blocca acquisto se scaduto</label></div>
                    <div class="col-md-6"><input asp-for="DefaultShowProgressBar" /> <label for="DefaultShowProgressBar">Progress bar default</label></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-4"><label class="le-field-label">Progress mode default</label></div>
                    <div class="col-md-8">
                        <select asp-for="DefaultProgressBarMode" class="form-control">
                            <option value="0">Tempo</option>
                            <option value="1">Stock</option>
                        </select>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-12">
                        <a class="btn btn-sm btn-secondary" href="@Url.Action("ExportTemplates", "LimitedTime", new { area = "Admin" })">Esporta template JSON</a>
                        <button type="button" class="btn btn-sm btn-secondary" id="le-import-btn">Importa template JSON</button>
                        <input type="file" id="le-import-file" accept="application/json,.json" style="display:none" />
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-6">
                        <label><input type="radio" name="le-preview-device" value="desktop" checked /> Preview desktop</label>
                        <label class="ml-3"><input type="radio" name="le-preview-device" value="mobile" /> Preview mobile</label>
                    </div>
                </div>
            </div>
        </div>

        <!-- TESTI -->
        <div class="le-settings-section">
            <div class="section-header" data-toggle="collapse" data-target="#sec-testi">Testi &amp; etichette</div>
            <div id="sec-testi" class="section-body collapse show">
                <div class="form-group row">
                    <div class="col-md-4"><label class="le-field-label">Messaggio personalizzato</label></div>
                    <div class="col-md-8"><textarea asp-for="CustomMessage" class="form-control" rows="2"></textarea></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-4"><label class="le-field-label">Testo badge</label></div>
                    <div class="col-md-8"><input asp-for="BadgeText" class="form-control" /></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-4"><label class="le-field-label">Testo pulsante CTA</label></div>
                    <div class="col-md-8"><input asp-for="CtaText" class="form-control" /></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-4"><label class="le-field-label">Testo offerta scaduta</label></div>
                    <div class="col-md-8"><input asp-for="ExpiredText" class="form-control" /></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3"><label class="le-field-label">Giorni</label></div>
                    <div class="col-md-3"><input asp-for="DaysLabel" class="form-control" /></div>
                    <div class="col-md-3"><label class="le-field-label">Ore</label></div>
                    <div class="col-md-3"><input asp-for="HoursLabel" class="form-control" /></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3"><label class="le-field-label">Minuti</label></div>
                    <div class="col-md-3"><input asp-for="MinutesLabel" class="form-control" /></div>
                    <div class="col-md-3"><label class="le-field-label">Secondi</label></div>
                    <div class="col-md-3"><input asp-for="SecondsLabel" class="form-control" /></div>
                </div>
            </div>
        </div>

        <!-- LAYOUT -->
        <div class="le-settings-section">
            <div class="section-header" data-toggle="collapse" data-target="#sec-layout">Layout &amp; visibilità</div>
            <div id="sec-layout" class="section-body collapse show">
                <div class="form-group row">
                    <div class="col-md-4"><label class="le-field-label">Layout timer</label></div>
                    <div class="col-md-8">
                        <select asp-for="TimerLayoutId" class="form-control" id="TimerLayoutId">
                            <option value="0">Horizontal</option>
                            <option value="1">Boxed (griglia 4 colonne)</option>
                            <option value="2">Minimal (solo cifre)</option>
                        </select>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-4"><label class="le-field-label">Allineamento testo</label></div>
                    <div class="col-md-8">
                        <select asp-for="CardTextAlign" class="form-control" id="CardTextAlign">
                            <option value="center">Centro</option>
                            <option value="left">Sinistra</option>
                            <option value="right">Destra</option>
                        </select>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-4"><label class="le-field-label">Font</label></div>
                    <div class="col-md-8">
                        <select asp-for="FontFamily" class="form-control" id="FontFamily">
                            <option value="inherit">Default del tema</option>
                            <option value="'Inter', sans-serif">Inter</option>
