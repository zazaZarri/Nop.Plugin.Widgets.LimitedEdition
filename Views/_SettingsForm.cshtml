                <div style="margin-bottom:6px;font-weight:700;color:#555;">Dati esempio (solo preview)</div>
                <label>Rimanenti</label><input type="number" id="pv-sample-remaining" value="12" min="0" />
                <label>Venduti</label><input type="number" id="pv-sample-sold" value="47" min="0" />
                <label>Iniziali</label><input type="number" id="pv-sample-initial" value="100" min="1" />
                <label>Sconto %</label><input type="number" id="pv-sample-discount" value="15" min="0" max="100" />
                <div style="margin-top:8px;">
                    <label><input type="checkbox" id="pv-sample-show-stock" checked /> Stock</label>
                    <label style="margin-left:10px;"><input type="checkbox" id="pv-sample-show-sold" checked /> Venduti</label>
                    <label style="margin-left:10px;"><input type="checkbox" id="pv-sample-show-progress" checked /> Progress</label>
                    <label style="margin-left:10px;"><input type="checkbox" id="pv-sample-dyn-badge" /> Badge dinamico</label>
                    <label style="margin-left:10px;"><input type="checkbox" id="pv-sample-use-image" /> Img sfondo</label>
                </div>
                <div style="margin-top:6px;">
                    <label>Progress mode</label>
                    <select id="pv-sample-progress-mode">
                        <option value="0">Tempo</option>
                        <option value="1">Stock</option>
                    </select>
                </div>
            </div>
            <p class="text-muted small mt-2 mb-0">L'anteprima replica la card homepage (badge, scarsità, progress, timer, CTA). Salva per applicare sul sito.</p>
        </div>
    </div>
</div>

<script>
(function () {
    var preview = document.getElementById('le-live-preview');
    if (!preview) return;

    var cssMap = {
        AccentColor: '--le-accent',
        AccentColorLight: '--le-accent-light',
        CardBackgroundStart: '--le-bg-start',
        CardBackgroundMid: '--le-bg-mid',
        CardBackgroundEnd: '--le-bg-end',
        BorderColor: '--le-border',
        TitleColor: '--le-title',
        MessageColor: '--le-message',
        BadgeTextColor: '--le-badge-text',
        BadgeBackgroundStart: '--le-badge-bg-start',
        BadgeBackgroundEnd: '--le-badge-bg-end',
        TimerDigitColor: '--le-digit',
        TimerLabelColor: '--le-label',
        TimerBoxBackground: '--le-box-bg',
        TimerBoxBorderColor: '--le-box-border',
        CtaBackgroundStart: '--le-cta-bg-start',
        CtaBackgroundEnd: '--le-cta-bg-end',
        CtaTextColor: '--le-cta-text',
        TimerDigitFontSize: ['--le-digit-size', 'px'],
        TimerLabelFontSize: ['--le-label-size', 'px'],
        TimerBoxMinWidth: ['--le-box-min-w', 'px'],
        TimerBoxBorderRadius: ['--le-box-radius', 'px'],
        TimerBoxPadding: ['--le-box-pad', 'px'],
        TimerGap: ['--le-timer-gap', 'px'],
        CardBorderRadius: ['--le-card-radius', 'px'],
        CardPaddingTop: ['--le-card-pad-t', 'px'],
        CardPaddingSide: ['--le-card-pad-s', 'px'],
        CardPaddingBottom: ['--le-card-pad-b', 'px'],
        CardMarginBottom: ['--le-card-margin-b', 'px'],
        CardBorderWidth: ['--le-card-border-w', 'px'],
        CardTextAlign: '--le-card-align',
        TitleFontSize: ['--le-title-size', 'px'],
        TitleFontWeight: '--le-title-weight',
        MessageFontSize: ['--le-msg-size', 'px'],
        BadgeFontSize: ['--le-badge-size', 'px'],
        BadgeFontWeight: '--le-badge-weight',
        BadgeLetterSpacing: ['--le-badge-ls', 'px'],
        BadgePaddingY: ['--le-badge-py', 'px'],
        BadgePaddingX: ['--le-badge-px', 'px'],
        CtaFontSize: ['--le-cta-size', 'px'],
        CtaFontWeight: '--le-cta-weight',
        CtaPaddingY: ['--le-cta-py', 'px'],
        CtaPaddingX: ['--le-cta-px', 'px'],
        CtaBorderRadius: ['--le-cta-radius', 'px'],
        FontFamily: '--le-font'
    };

    function toHex(val) {
        if (!val) return '#000000';
        val = ('' + val).trim();
        if (val.charAt(0) === '#' && (val.length === 7 || val.length === 4)) return val;
        var m = val.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
        if (m) {
            return '#' + [m[1], m[2], m[3]].map(function (x) {
                return ('0' + parseInt(x, 10).toString(16)).slice(-2);
            }).join('');
        }
        return '#000000';
    }

    function applyCss(field, value) {
        var map = cssMap[field];
        if (!map) return;
        if (Array.isArray(map)) preview.style.setProperty(map[0], value + map[1]);
        else preview.style.setProperty(map, value);
    }

    function updateVisibility() {
        var map = { ShowBadge: 'pv-badge', ShowTitle: 'pv-title', ShowMessage: 'pv-message', ShowCta: 'pv-cta' };
        Object.keys(map).forEach(function (id) {
            var el = document.getElementById(id);
            var target = document.getElementById(map[id]);
            if (el && target) target.style.display = el.checked ? '' : 'none';
        });
    }

    function updateLayout() {
        var sel = document.getElementById('TimerLayoutId');
        if (sel) {
            preview.classList.remove('le-layout-horizontal', 'le-layout-boxed', 'le-layout-minimal');
            var v = parseInt(sel.value, 10);
            if (v === 1) preview.classList.add('le-layout-boxed');
            else if (v === 2) preview.classList.add('le-layout-minimal');
            else preview.classList.add('le-layout-horizontal');
        }
        // template class (come homepage)
        preview.classList.remove('le-tpl-classic', 'le-tpl-minimal', 'le-tpl-neon', 'le-tpl-soft', 'le-tpl-story');
        var tpl = document.getElementById('CardTemplateSelect') || document.getElementById('SelectedCardTemplateId');
        var tid = tpl ? parseInt(tpl.value, 10) : 0;
        var map = { 0: 'le-tpl-classic', 1: 'le-tpl-minimal', 2: 'le-tpl-neon', 3: 'le-tpl-soft', 4: 'le-tpl-story' };
        preview.classList.add(map[tid] || 'le-tpl-classic');
    }

    function updateScarcityPreview() {
        var remaining = parseInt((document.getElementById('pv-sample-remaining') || {}).value || '12', 10);
        var sold = parseInt((document.getElementById('pv-sample-sold') || {}).value || '47', 10);
        var initial = parseInt((document.getElementById('pv-sample-initial') || {}).value || '100', 10);
        var discount = parseFloat((document.getElementById('pv-sample-discount') || {}).value || '0');
        var showStock = (document.getElementById('pv-sample-show-stock') || {}).checked;
        var showSold = (document.getElementById('pv-sample-show-sold') || {}).checked;
        var showProg = (document.getElementById('pv-sample-show-progress') || {}).checked;
        // sync with global default if present
        var defProg = document.getElementById('DefaultShowProgressBar');
        if (defProg && !document.getElementById('pv-sample-show-progress').matches(':focus')) {
            // keep sample checkbox independent for preview demo
        }
        var mode = parseInt((document.getElementById('pv-sample-progress-mode') || {}).value || '0', 10);
        var dyn = (document.getElementById('pv-sample-dyn-badge') || {}).checked;
        var useImg = (document.getElementById('pv-sample-use-image') || {}).checked;
        var useImgSetting = document.getElementById('UseProductImageAsBackground');
        if (useImgSetting) useImg = useImg || useImgSetting.checked;

        var scar = document.getElementById('pv-scarcity');
        var remEl = document.getElementById('pv-remaining');
        var soldEl = document.getElementById('pv-sold');
        if (remEl) remEl.textContent = remaining;
        if (soldEl) soldEl.textContent = sold;
        if (scar) {
            if (!showStock && !showSold) scar.style.display = 'none';
            else {
                scar.style.display = '';
                var parts = [];
                if (showStock) parts.push('Restano <strong id="pv-remaining">' + remaining + '</strong> pezzi');
                if (showSold) parts.push('<strong id="pv-sold">' + sold + '</strong> già venduti');
                scar.innerHTML = parts.join(' · ');
            }
        }

        var prog = document.getElementById('pv-progress');
        var bar = document.getElementById('pv-progress-bar');
        if (prog) prog.style.display = showProg ? '' : 'none';
        if (bar && showProg) {
            var pct = 45;
            if (mode === 1 && initial > 0) pct = Math.min(100, Math.round(100 * sold / initial));
            bar.style.width = pct + '%';
        }

        var disc = document.getElementById('pv-discount');
        if (disc) {
            if (discount > 0) {
                disc.style.display = '';
                disc.textContent = '-' + Math.round(discount) + '%';
            } else disc.style.display = 'none';
        }

        var badge = document.getElementById('pv-badge');
        if (badge && dyn) {
            badge.classList.add('le-dyn');
            if (remaining <= 0) badge.textContent = 'SOLD OUT';
            else if (initial > 0 && (100 * remaining / initial) <= 20) badge.textContent = 'QUASI ESAURITO';
            else badge.textContent = 'ULTIME 24H';
        } else if (badge) {
            badge.classList.remove('le-dyn');
            var bt = document.getElementById('BadgeText');
            if (bt && bt.value) badge.textContent = bt.value;
        }
        var card = preview.querySelector('.le-card');
        if (card) {
            if (useImg) {
                card.style.backgroundImage = 'linear-gradient(180deg, rgba(0,0,0,.4), rgba(0,0,0,.75)), url("data:image/svg+xml,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'400\' height=\'300\'><rect fill=\'%23444\' width=\'400\' height=\'300\'/><text x=\'50%25\' y=\'50%25\' fill=\'%23aaa\' text-anchor=\'middle\' font-size=\'16\'>Product image</text></svg>")';
                card.style.backgroundSize = 'cover';
                card.style.backgroundPosition = 'center';
            } else {
                card.style.backgroundImage = '';
                // restore gradient from CSS vars
                card.style.background = '';
            }
        }
    }

    function updateTexts() {
        var map = {
            BadgeText: 'pv-badge', CustomMessage: 'pv-message', CtaText: 'pv-cta',
            DaysLabel: 'pv-days', HoursLabel: 'pv-hours', MinutesLabel: 'pv-mins', SecondsLabel: 'pv-secs'
        };
        Object.keys(map).forEach(function (id) {
            var el = document.getElementById(id);
            var target = document.getElementById(map[id]);
            if (el && target) target.textContent = el.value || target.textContent;
        });
    }

    document.querySelectorAll('.le-color-picker').forEach(function (picker) {
        var targetName = picker.getAttribute('data-target');
        var textInput = document.querySelector('[data-field="' + targetName + '"]') || document.getElementById(targetName);
        if (textInput && textInput.value) {
            try { picker.value = toHex(textInput.value); } catch (e) {}
        }
        picker.addEventListener('input', function () {
            if (textInput) {
                textInput.value = picker.value;
                applyCss(targetName, picker.value);
            }
        });
        if (textInput) {
            textInput.addEventListener('input', function () {
                try { picker.value = toHex(textInput.value); } catch (e) {}
                applyCss(targetName, textInput.value);
            });
            applyCss(targetName, textInput.value);
        }
    });

    document.querySelectorAll('.le-range').forEach(function (range) {
        var field = range.getAttribute('data-field');
        var label = document.querySelector('.le-range-val[data-for="' + field + '"]');
        range.addEventListener('input', function () {
            if (label) label.textContent = range.value;
            applyCss(field, range.value);
        });
        applyCss(field, range.value);
    });

    document.querySelectorAll('.le-select-preview, #TimerLayoutId, #CardTextAlign, #FontFamily').forEach(function (sel) {
        sel.addEventListener('change', function () {
            var field = sel.getAttribute('data-field') || sel.id;
            if (field === 'TimerLayoutId') updateLayout();
            else applyCss(field, sel.value);
        });
        var field = sel.getAttribute('data-field') || sel.id;
        if (field !== 'TimerLayoutId') applyCss(field, sel.value);
    });

    ['ShowBadge', 'ShowTitle', 'ShowMessage', 'ShowCta'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.addEventListener('change', updateVisibility);
    });

    ['BadgeText', 'CustomMessage', 'CtaText', 'DaysLabel', 'HoursLabel', 'MinutesLabel', 'SecondsLabel'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.addEventListener('input', updateTexts);
    });

    updateVisibility();
    updateLayout();
    updateTexts();
    updateScarcityPreview();

    ['pv-sample-remaining','pv-sample-sold','pv-sample-initial','pv-sample-discount','pv-sample-progress-mode'].forEach(function(id){
        var e = document.getElementById(id);
        if (e) e.addEventListener('input', updateScarcityPreview);
        if (e) e.addEventListener('change', updateScarcityPreview);
    });
    ['pv-sample-show-stock','pv-sample-show-sold','pv-sample-show-progress','pv-sample-dyn-badge','pv-sample-use-image'].forEach(function(id){
        var e = document.getElementById(id);
        if (e) e.addEventListener('change', updateScarcityPreview);
    });
    var defProg = document.getElementById('DefaultShowProgressBar');
    if (defProg) {
        defProg.addEventListener('change', function(){
            var cb = document.getElementById('pv-sample-show-progress');
            if (cb) { cb.checked = defProg.checked; updateScarcityPreview(); }
        });
    }
    var defMode = document.getElementById('DefaultProgressBarMode');
    if (defMode) {
        defMode.addEventListener('change', function(){
            var s = document.getElementById('pv-sample-progress-mode');
            if (s) { s.value = defMode.value; updateScarcityPreview(); }
        });
    }
    var dynBadge = document.getElementById('EnableDynamicBadges');
    if (dynBadge) {
        dynBadge.addEventListener('change', function(){
            var cb = document.getElementById('pv-sample-dyn-badge');
            if (cb) { cb.checked = dynBadge.checked; updateScarcityPreview(); }
        });
    }
    var useImgSet = document.getElementById('UseProductImageAsBackground');
    if (useImgSet) {
        var sampleImg = document.getElementById('pv-sample-use-image');
        if (sampleImg) sampleImg.checked = useImgSet.checked;
        useImgSet.addEventListener('change', function(){
            if (sampleImg) sampleImg.checked = useImgSet.checked;
            updateScarcityPreview();
        });
    }

    // ── Template switcher (card) ───────────────────────────────────────────
    var cardSelect = document.getElementById('CardTemplateSelect');
    var cardHidden = document.getElementById('SelectedCardTemplateId');
    if (cardSelect && cardHidden) {
        cardSelect.value = cardHidden.value || '0';
        cardSelect.addEventListener('change', function () {
            var tid = parseInt(cardSelect.value, 10);
            cardHidden.value = tid;
            // Carica stile del template via AJAX
            fetch('@Url.Action("GetTemplateStyle", "LimitedTime", new { area = "Admin" })?kind=card&templateId=' + tid)
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (!data || !data.success || !data.style) return;
                    var st = data.style;
                    function setVal(id, v) {
                        var e = document.getElementById(id);
                        if (!e || v === undefined || v === null) return;
                        if (e.type === 'checkbox') e.checked = !!v;
                        else e.value = v;
                        e.dispatchEvent(new Event('input', { bubbles: true }));
                        e.dispatchEvent(new Event('change', { bubbles: true }));
                    }
                    setVal('BadgeText', st.badgeText || st.BadgeText);
                    setVal('CtaText', st.ctaText || st.CtaText);
                    setVal('ExpiredText', st.expiredText || st.ExpiredText);
                    setVal('DaysLabel', st.daysLabel || st.DaysLabel);
                    setVal('HoursLabel', st.hoursLabel || st.HoursLabel);
                    setVal('MinutesLabel', st.minutesLabel || st.MinutesLabel);
                    setVal('SecondsLabel', st.secondsLabel || st.SecondsLabel);
                    setVal('ShowBadge', st.showBadge !== undefined ? st.showBadge : st.ShowBadge);
                    setVal('ShowTitle', st.showTitle !== undefined ? st.showTitle : st.ShowTitle);
                    setVal('ShowMessage', st.showMessage !== undefined ? st.showMessage : st.ShowMessage);
                    setVal('ShowCta', st.showCta !== undefined ? st.showCta : st.ShowCta);
                    setVal('EnableGlowAnimation', st.enableGlowAnimation !== undefined ? st.enableGlowAnimation : st.EnableGlowAnimation);
                    setVal('EnableSheenAnimation', st.enableSheenAnimation !== undefined ? st.enableSheenAnimation : st.EnableSheenAnimation);
                    setVal('TimerLayoutId', st.timerLayoutId !== undefined ? st.timerLayoutId : st.TimerLayoutId);
                    setVal('AccentColor', st.accentColor || st.AccentColor);
                    setVal('AccentColorLight', st.accentColorLight || st.AccentColorLight);
                    setVal('CardBackgroundStart', st.cardBackgroundStart || st.CardBackgroundStart);
                    setVal('CardBackgroundMid', st.cardBackgroundMid || st.CardBackgroundMid);
                    setVal('CardBackgroundEnd', st.cardBackgroundEnd || st.CardBackgroundEnd);
                    setVal('BorderColor', st.borderColor || st.BorderColor);
                    setVal('TitleColor', st.titleColor || st.TitleColor);
                    setVal('MessageColor', st.messageColor || st.MessageColor);
                    setVal('BadgeTextColor', st.badgeTextColor || st.BadgeTextColor);
                    setVal('BadgeBackgroundStart', st.badgeBackgroundStart || st.BadgeBackgroundStart);
                    setVal('BadgeBackgroundEnd', st.badgeBackgroundEnd || st.BadgeBackgroundEnd);
                    setVal('TimerDigitColor', st.timerDigitColor || st.TimerDigitColor);
                    setVal('TimerLabelColor', st.timerLabelColor || st.TimerLabelColor);
                    setVal('TimerBoxBackground', st.timerBoxBackground || st.TimerBoxBackground);
                    setVal('TimerBoxBorderColor', st.timerBoxBorderColor || st.TimerBoxBorderColor);
                    setVal('CtaBackgroundStart', st.ctaBackgroundStart || st.CtaBackgroundStart);
                    setVal('CtaBackgroundEnd', st.ctaBackgroundEnd || st.CtaBackgroundEnd);
                    setVal('CtaTextColor', st.ctaTextColor || st.CtaTextColor);
                    setVal('TimerDigitFontSize', st.timerDigitFontSize || st.TimerDigitFontSize);
                    setVal('TimerLabelFontSize', st.timerLabelFontSize || st.TimerLabelFontSize);
                    setVal('TimerBoxMinWidth', st.timerBoxMinWidth || st.TimerBoxMinWidth);
                    setVal('TimerBoxBorderRadius', st.timerBoxBorderRadius !== undefined ? st.timerBoxBorderRadius : st.TimerBoxBorderRadius);
                    setVal('TimerBoxPadding', st.timerBoxPadding !== undefined ? st.timerBoxPadding : st.TimerBoxPadding);
                    setVal('TimerGap', st.timerGap !== undefined ? st.timerGap : st.TimerGap);
                    setVal('CardBorderRadius', st.cardBorderRadius !== undefined ? st.cardBorderRadius : st.CardBorderRadius);
                    setVal('CardPaddingTop', st.cardPaddingTop || st.CardPaddingTop);
                    setVal('CardPaddingSide', st.cardPaddingSide || st.CardPaddingSide);
                    setVal('CardPaddingBottom', st.cardPaddingBottom || st.CardPaddingBottom);
                    setVal('CardMarginBottom', st.cardMarginBottom !== undefined ? st.cardMarginBottom : st.CardMarginBottom);
                    setVal('CardBorderWidth', st.cardBorderWidth !== undefined ? st.cardBorderWidth : st.CardBorderWidth);
                    setVal('CardTextAlign', st.cardTextAlign || st.CardTextAlign);
                    setVal('TitleFontSize', st.titleFontSize || st.TitleFontSize);
                    setVal('TitleFontWeight', st.titleFontWeight || st.TitleFontWeight);
                    setVal('MessageFontSize', st.messageFontSize || st.MessageFontSize);
                    setVal('BadgeFontSize', st.badgeFontSize || st.BadgeFontSize);
                    setVal('BadgeFontWeight', st.badgeFontWeight || st.BadgeFontWeight);
                    setVal('BadgeLetterSpacing', st.badgeLetterSpacing !== undefined ? st.badgeLetterSpacing : st.BadgeLetterSpacing);
                    setVal('BadgePaddingY', st.badgePaddingY !== undefined ? st.badgePaddingY : st.BadgePaddingY);
                    setVal('BadgePaddingX', st.badgePaddingX || st.BadgePaddingX);
                    setVal('CtaFontSize', st.ctaFontSize || st.CtaFontSize);
                    setVal('CtaFontWeight', st.ctaFontWeight || st.CtaFontWeight);
                    setVal('CtaPaddingY', st.ctaPaddingY || st.CtaPaddingY);
                    setVal('CtaPaddingX', st.ctaPaddingX || st.CtaPaddingX);
                    setVal('CtaBorderRadius', st.ctaBorderRadius !== undefined ? st.ctaBorderRadius : st.CtaBorderRadius);
                    setVal('FontFamily', st.fontFamily || st.FontFamily);
                    // sync color pickers
                    document.querySelectorAll('.le-color-picker').forEach(function (picker) {
                        var targetName = picker.getAttribute('data-target');
                        var textInput = document.getElementById(targetName);
                        if (textInput && textInput.value) {
                            try { picker.value = toHex(textInput.value); } catch (e) {}
                        }
                    });
                    document.querySelectorAll('.le-range').forEach(function (range) {
                        var field = range.getAttribute('data-field');
                        var label = document.querySelector('.le-range-val[data-for="' + field + '"]');
                        if (label) label.textContent = range.value;
                    });
                    updateVisibility();
                    updateLayout();
                    updateTexts();
                });
        });
    }

    // Import templates
    var impBtn = document.getElementById('le-import-btn');
    var impFile = document.getElementById('le-import-file');
    if (impBtn && impFile) {
        impBtn.addEventListener('click', function () { impFile.click(); });
        impFile.addEventListener('change', function () {
            var f = impFile.files && impFile.files[0];
            if (!f) return;
            var reader = new FileReader();
            reader.onload = function () {
                var token = document.querySelector('input[name="__RequestVerificationToken"]');
                var body = new FormData();
                body.append('templatesJson', reader.result);
                if (token) body.append('__RequestVerificationToken', token.value);
                fetch('@Url.Action("ImportTemplates", "LimitedTime", new { area = "Admin" })', { method: 'POST', body: body })
                    .then(function (r) { return r.json(); })
                    .then(function (d) {
                        if (d && d.success) location.reload();
                        else alert('Import fallito: ' + (d && d.error ? d.error : ''));
                    });
            };
            reader.readAsText(f);
        });
    }
    // Mobile/desktop preview (stesso comportamento responsive del frontend)
    document.querySelectorAll('input[name="le-preview-device"]').forEach(function (r) {
        r.addEventListener('change', function () {
            var wrap = document.querySelector('.le-admin-preview-wrap');
            if (!wrap) return;
            if (r.value === 'mobile') {
                wrap.style.maxWidth = '375px';
                wrap.style.marginLeft = 'auto';
                wrap.style.marginRight = 'auto';
                wrap.classList.add('is-mobile-preview');
            } else {
                wrap.style.maxWidth = '';
                wrap.style.marginLeft = '';
                wrap.style.marginRight = '';
                wrap.classList.remove('is-mobile-preview');
            }
        });
    });

})();
</script>