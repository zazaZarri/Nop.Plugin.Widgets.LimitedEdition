@model ConfigurationModel

@{
    Layout = "_ConfigurePlugin";
    if (Model.TimerDigitFontSize <= 0) Model.TimerDigitFontSize = 26;
    if (Model.TimerLabelFontSize <= 0) Model.TimerLabelFontSize = 9;
    if (Model.TimerBoxMinWidth <= 0) Model.TimerBoxMinWidth = 58;
    if (Model.TimerBoxBorderRadius < 0) Model.TimerBoxBorderRadius = 10;
    if (Model.TimerBoxPadding < 0) Model.TimerBoxPadding = 8;
    if (Model.TimerGap < 0) Model.TimerGap = 10;
    if (Model.CardBorderRadius < 0) Model.CardBorderRadius = 16;
    if (Model.CardPaddingTop <= 0) Model.CardPaddingTop = 28;
    if (Model.CardPaddingSide <= 0) Model.CardPaddingSide = 24;
    if (Model.CardPaddingBottom <= 0) Model.CardPaddingBottom = 24;
    if (Model.CardMarginBottom < 0) Model.CardMarginBottom = 22;
    if (Model.TitleFontSize <= 0) Model.TitleFontSize = 22;
    if (Model.TitleFontWeight <= 0) Model.TitleFontWeight = 700;
    if (Model.MessageFontSize <= 0) Model.MessageFontSize = 14;
    if (Model.BadgeFontSize <= 0) Model.BadgeFontSize = 11;
    if (Model.BadgeFontWeight <= 0) Model.BadgeFontWeight = 800;
    if (Model.BadgeLetterSpacing < 0) Model.BadgeLetterSpacing = 2;
    if (Model.BadgePaddingY < 0) Model.BadgePaddingY = 5;
    if (Model.BadgePaddingX <= 0) Model.BadgePaddingX = 14;
    if (Model.CtaFontSize <= 0) Model.CtaFontSize = 14;
    if (Model.CtaFontWeight <= 0) Model.CtaFontWeight = 700;
    if (Model.CtaPaddingY <= 0) Model.CtaPaddingY = 11;
    if (Model.CtaPaddingX <= 0) Model.CtaPaddingX = 28;
    if (Model.CtaBorderRadius < 0) Model.CtaBorderRadius = 999;
    if (string.IsNullOrEmpty(Model.CardTextAlign)) Model.CardTextAlign = "center";
    if (string.IsNullOrEmpty(Model.AccentColor)) Model.AccentColor = "#d4af37";
    if (string.IsNullOrEmpty(Model.AccentColorLight)) Model.AccentColorLight = "#f4e5a1";
    if (string.IsNullOrEmpty(Model.CardBackgroundStart)) Model.CardBackgroundStart = "#0b0b0f";
    if (string.IsNullOrEmpty(Model.CardBackgroundMid)) Model.CardBackgroundMid = "#1a1a22";
    if (string.IsNullOrEmpty(Model.CardBackgroundEnd)) Model.CardBackgroundEnd = "#0b0b0f";
    if (string.IsNullOrEmpty(Model.BorderColor)) Model.BorderColor = "rgba(212, 175, 55, 0.45)";
    if (string.IsNullOrEmpty(Model.TitleColor)) Model.TitleColor = "#ffffff";
    if (string.IsNullOrEmpty(Model.MessageColor)) Model.MessageColor = "rgba(255, 255, 255, 0.72)";
    if (string.IsNullOrEmpty(Model.BadgeTextColor)) Model.BadgeTextColor = "#1a1a22";
    if (string.IsNullOrEmpty(Model.BadgeBackgroundStart)) Model.BadgeBackgroundStart = "#f4e5a1";
    if (string.IsNullOrEmpty(Model.BadgeBackgroundEnd)) Model.BadgeBackgroundEnd = "#d4af37";
    if (string.IsNullOrEmpty(Model.TimerDigitColor)) Model.TimerDigitColor = "#f4e5a1";
    if (string.IsNullOrEmpty(Model.TimerLabelColor)) Model.TimerLabelColor = "rgba(255, 255, 255, 0.45)";
    if (string.IsNullOrEmpty(Model.TimerBoxBackground)) Model.TimerBoxBackground = "rgba(212, 175, 55, 0.08)";
    if (string.IsNullOrEmpty(Model.TimerBoxBorderColor)) Model.TimerBoxBorderColor = "rgba(212, 175, 55, 0.35)";
    if (string.IsNullOrEmpty(Model.CtaBackgroundStart)) Model.CtaBackgroundStart = "#d4af37";
    if (string.IsNullOrEmpty(Model.CtaBackgroundEnd)) Model.CtaBackgroundEnd = "#f4e5a1";
    if (string.IsNullOrEmpty(Model.CtaTextColor)) Model.CtaTextColor = "#1a1a22";
    if (string.IsNullOrEmpty(Model.BadgeText)) Model.BadgeText = "⚡ Edizione Limitata";
    if (string.IsNullOrEmpty(Model.CtaText)) Model.CtaText = "Vedi offerta →";
    if (string.IsNullOrEmpty(Model.ExpiredText)) Model.ExpiredText = "Offerta scaduta!";
    if (string.IsNullOrEmpty(Model.DaysLabel)) Model.DaysLabel = "Giorni";
    if (string.IsNullOrEmpty(Model.HoursLabel)) Model.HoursLabel = "Ore";
    if (string.IsNullOrEmpty(Model.MinutesLabel)) Model.MinutesLabel = "Min";
    if (string.IsNullOrEmpty(Model.SecondsLabel)) Model.SecondsLabel = "Sec";
}

<form id="le-configure-form" method="post" action="javascript:void(0);">
    @Html.AntiForgeryToken()
    <div class="cards-group">

        <div class="card card-default">
            <div class="card-header">
                Impostazioni visualizzazione Limited Edition
            </div>
            <div class="card-body">
                @await Html.PartialAsync("~/Plugins/Widgets.LimitedEdition/Views/_SettingsForm.cshtml", Model)
            </div>
        </div>

        <div class="card card-default">
            <div class="card-header">
                Popup carrello (anteprima e impostazioni)
            </div>
            <div class="card-body">
                @await Html.PartialAsync("~/Plugins/Widgets.LimitedEdition/Views/_PopupSettingsForm.cshtml", Model)
            </div>
        </div>

    </div>

    <div class="form-group row mt-3">
        <div class="col-md-9 offset-md-3">
            <button type="button" id="le-save-btn" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.Save")
            </button>
            <span id="le-save-status" class="ml-3" style="font-weight:600;"></span>
        </div>
    </div>
</form>

<div class="cards-group mt-3">
    <div class="card card-default">
        <div class="card-header">
            Prodotti a tempo limitato
        </div>
        @await Html.PartialAsync("~/Plugins/Widgets.LimitedEdition/Views/_ProductsGrid.cshtml", Model.LimitedTimeProductSearchModel)
    </div>
</div>

<script>
(function () {
    var btn = document.getElementById('le-save-btn');
    var status = document.getElementById('le-save-status');
    var form = document.getElementById('le-configure-form');
    if (!btn || !form) return;

    function token() {
        var el = form.querySelector('input[name="__RequestVerificationToken"]');
        return el ? el.value : '';
    }

    btn.addEventListener('click', function () {
        btn.disabled = true;
        if (status) {
            status.style.color = '#666';
            status.textContent = 'Salvataggio in corso...';
        }

        var fd = new FormData();
        var tokenEl = form.querySelector('input[name="__RequestVerificationToken"]');
        if (tokenEl) fd.append('__RequestVerificationToken', tokenEl.value);

        // tutti gli input/select/textarea del form
        form.querySelectorAll('input, select, textarea').forEach(function (el) {
            if (!el.name || el.name === '__RequestVerificationToken') return;
            var type = (el.type || '').toLowerCase();
            if (type === 'checkbox') {
                fd.append(el.name, el.checked ? 'true' : 'false');
            } else if (type === 'radio') {
                if (el.checked) fd.append(el.name, el.value);
            } else if (type === 'file') {
                // skip
            } else {
                fd.append(el.name, el.value != null ? el.value : '');
            }
        });

        // sincronizza hidden template id dai select se presenti
        var cardSel = document.getElementById('CardTemplateSelect');
        var cardHid = document.getElementById('SelectedCardTemplateId');
        if (cardSel && cardHid) {
            cardHid.value = cardSel.value;
            fd.set('SelectedCardTemplateId', cardSel.value);
        }
        var popSel = document.getElementById('PopupTemplateSelect');
        var popHid = document.getElementById('SelectedPopupTemplateId');
        if (popSel && popHid) {
            popHid.value = popSel.value;
            fd.set('SelectedPopupTemplateId', popSel.value);
        }

        fetch('@Url.Action("SaveSettingsAjax", "LimitedTime", new { area = "Admin" })', {
            method: 'POST',
            body: fd,
            headers: {
                'RequestVerificationToken': tokenEl ? tokenEl.value : ''
            },
            credentials: 'same-origin'
        })
        .then(function (r) {
            return r.text().then(function (text) {
                var data;
                try { data = JSON.parse(text); }
                catch (e) {
                    throw new Error('Risposta non JSON (HTTP ' + r.status + '): ' + text.substring(0, 300));
                }
                if (!r.ok && !(data && data.success)) throw new Error((data && data.message) || ('HTTP ' + r.status));
                return data;
            });
        })
        .then(function (data) {
            if (data && data.success) {
                if (status) {
                    status.style.color = '#0a0';
                    status.textContent = '✓ Tutte le impostazioni salvate';
                }
                alert('Tutte le impostazioni salvate correttamente.\n\nBadge: ' + (data.badgeText || '') + '\nAccent: ' + (data.accentColor || '') + '\nCTA: ' + (data.ctaText || ''));
            } else {
                var msg = (data && data.message) ? data.message : 'Salvataggio fallito';
                if (status) {
                    status.style.color = '#c00';
                    status.textContent = '✗ ' + msg;
                }
                alert('Errore salvataggio: ' + msg);
            }
        })
        .catch(function (err) {
            if (status) {
                status.style.color = '#c00';
                status.textContent = '✗ ' + err.message;
            }
            alert('Errore salvataggio: ' + err.message);
        })
        .finally(function () {
            btn.disabled = false;
        });
    });

})();
</script>
